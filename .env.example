# Public browser configuration (safe publishable key only).
NEXT_PUBLIC_SUPABASE_URL=https://bvvptxhgiqvaisegxarp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for compatibility.

# Server-only. Set one of these in your hosting environment. Never add NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Legacy server-only alternative
FASHN_API_KEY=

# Canonical HTTPS deployment URL, without a trailing slash.
APP_URL=http://localhost:3000
# Recommended fidelity setting; tryon-v1.6 is supported only when explicitly selected.
FASHN_MODEL=tryon-max
FASHN_RESOLUTION=2k

# Keep public processing paused until an owner preview and billing are verified.
PUBLIC_TRYON_ENABLED=false
# Attempt caps reset at midnight UTC; failed and cleared attempts still count.
TRYON_SHOP_DAILY_LIMIT=10
TRYON_IP_DAILY_LIMIT=5
TRYON_GLOBAL_DAILY_LIMIT=100

# Only set true behind a trusted proxy that overwrites X-Forwarded-For.
# Vercel is detected automatically.
TRUST_PROXY=false
